[Unit]
Description=f4commons MCP server (f4decomp group notes, board and source pool)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
# Retry rather than give up while the network or database comes up.
StartLimitIntervalSec=0

[Service]
User=f4commons
Group=f4commons
WorkingDirectory=/opt/f4commons
Environment=F4COMMONS_HOST=127.0.0.1
Environment=F4COMMONS_URL=https://commons.example.org/f4commons
Environment=F4COMMONS_ALLOWED_HOSTS=commons.example.org
Environment=F4COMMONS_PORT=4410
ExecStart=/opt/f4commons/venv/bin/python /opt/f4commons/server.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/f4commons
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
